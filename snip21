export default {
  async fetch(request) {
    try {
      const url =
        new URL(request.url);

      // 只處理 POST。
      if (request.method !== "POST") {
        return new Response(null, {
          status: 204
        });
      }

      return await handleXHTTP(
        request,
        url
      );

    } catch (error) {
      return new Response(
        "Internal error",
        {
          status: 500
        }
      );
    }
  }
};
